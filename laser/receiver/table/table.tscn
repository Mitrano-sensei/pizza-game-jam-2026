[sub_resource type="CSharpScript" id="CSharpScript_hyjps"]
script/source = "using Godot;

public partial class Table : RigidBody3D
{
    public override void _Ready()
    {
        // The glb importer (\"generate/physics\") wraps each mesh's shape in its own StaticBody3D.
        // A RigidBody3D only uses CollisionShape3D direct children, so hoist the shapes onto this body.
        foreach (var body in FindChildren(\"*\", nameof(StaticBody3D), true, false))
        {
            foreach (var child in body.GetChildren())
                if (child is CollisionShape3D shape)
                    shape.Reparent(this); // keeps global transform (incl. the 0.76 instance scale)
            body.Free();
        }
    }
}
"

